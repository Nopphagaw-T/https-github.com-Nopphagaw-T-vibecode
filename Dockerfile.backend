FROM node:22-alpine AS base
WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy backend source code and prisma files
COPY server/ ./server/
COPY prisma/ ./prisma/
COPY .env.local ./

# Generate Prisma client
RUN npx prisma generate

# Build (if any TypeScript) - transpile if needed
RUN npx tsc --noEmit || echo "No TypeScript build required"

EXPOSE 5002
ENV PORT=5002
CMD ["node", "server/index.ts"]
