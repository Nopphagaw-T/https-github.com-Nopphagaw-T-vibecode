# Use official Node.js image for frontend
FROM node:22-alpine AS base
WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy source code
COPY . .

# Expose development server port (default Vite port)
ENV PORT=3001
EXPOSE 3001

# Run Vite dev server
CMD ["npm", "run", "dev"]
